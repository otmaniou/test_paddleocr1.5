from PIL import Image
import torch
import time

IMAGE_PATH = "/chemin/vers/une_image_test.jpg"

image = Image.open(IMAGE_PATH).convert("RGB")

prompt = "OCR:"

inputs = processor(
    images=image,
    text=prompt,
    return_tensors="pt"
)

inputs = {
    k: v.to("cuda") if torch.is_tensor(v) else v
    for k, v in inputs.items()
}

t0 = time.time()

with torch.inference_mode():
    outputs = model.generate(
        **inputs,
        max_new_tokens=2048,
        do_sample=False
    )

result = processor.batch_decode(
    outputs,
    skip_special_tokens=True
)[0]

print("Temps :", round(time.time() - t0, 2), "s")
print("\n===== RESULTAT =====\n")
print(result)
